{
  "manifest_version": 3,
  "name": "COR3 RU Hover Translator",
  "version": "1.1.3",
  "description": "Unofficial handmade Russian hover translator for cor3.gg. Use at your own responsibility.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://cor3.gg/*",
    "https://translate.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://cor3.gg/*",
        "https://www.cor3.gg/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "COR3 RU Hover Translator",
    "default_popup": "popup.html"
  }
}